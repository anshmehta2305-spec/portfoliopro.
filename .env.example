# ==============================================================================
# Portfolio Pro - Environment Configuration Specification
# ==============================================================================

# STAGE 1: PLATFORM MODE FLAGS
# ------------------------------------------------------------------------------
# Set to 'false' for Public Showcase Launch (Preview/Demo mode).
# Set to 'true' only when BSE/NSE rails, payment gateways, and AMFI compliance are cleared.
NEXT_PUBLIC_LIVE_TRADING_ENABLED="false"

# AMFI Registration & Regulatory License Numbers
# If left empty in showcase mode, displays 'ARN Pending Activation'
NEXT_PUBLIC_AMFI_ARN=""
NEXT_PUBLIC_AMFI_EUIN=""

# Showcase Private Demo Passcode (protects /demo client presentation page)
DEMO_ACCESS_PASSWORD="demomode2026"

# Database Connection (PostgreSQL for Production, SQLite for Local Dev)
# ------------------------------------------------------------------------------
# Local Development (SQLite):
DATABASE_URL="file:./dev.db"
# Production Managed PostgreSQL (Supabase / Neon / AWS RDS):
# DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# NextAuth Authentication & Security
# ------------------------------------------------------------------------------
# In production, generate with: openssl rand -base64 32
NEXTAUTH_SECRET="portfolio-pro-super-secret-key-change-in-production-2026"
NEXTAUTH_URL="https://portfoliopro.in"

# Data Encryption at Rest (AES-256-GCM for PAN, Bank Accounts, Aadhar numbers)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# STAGE 2: BROKER & PAYMENT RAILS (Sandbox vs Production)
# ------------------------------------------------------------------------------
BSE_NSE_MODE="sandbox" # 'sandbox' | 'production'
PAYMENT_GATEWAY_MODE="sandbox" # 'sandbox' | 'production'

# BSE StarMF API Credentials
BSE_STAR_MEMBER_CODE=""
BSE_STAR_USER_ID=""
BSE_STAR_PASSWORD=""
BSE_STAR_API_URL="https://bsestarmfdemo.bseindia.com/StarMFWebService/StarMFWebService.svc"

# NSE NMF II API Credentials
NSE_NMF_BROKER_CODE=""
NSE_NMF_APP_KEY=""
NSE_NMF_API_URL="https://sandbox.nsenmf.com/api/v2"

# Payment Gateway (Razorpay / BillDesk)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# CKYC / KRA & DigiLocker Verification Rails
CKYC_API_KEY=""
CKYC_API_ENDPOINT="https://sandbox.cvlkra.com/api/v1"
DIGILOCKER_CLIENT_ID=""
DIGILOCKER_CLIENT_SECRET=""

# AMFI Mutual Fund NAV Feed
AMFI_NAV_URL="https://www.amfiindia.com/spages/NAVAll.txt"

# Transactional Communications (Email, SMS & WhatsApp)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="apikey"
SMTP_PASS=""
EMAIL_FROM="Portfolio Pro <no-reply@portfoliopro.in>"
SALES_EMAIL="sales@portfoliopro.in"

WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
