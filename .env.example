# ==============================================================================
# Portfolio Pro - Environment Configuration
# ==============================================================================

# Database Connection
# ------------------------------------------------------------------------------
# For local SQLite development (zero configuration required out of the box):
DATABASE_URL="file:./dev.db"
# For production PostgreSQL (Supabase, Neon, Railway, AWS RDS, etc.):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/portfolio_pro?schema=public"

# NextAuth Authentication
# ------------------------------------------------------------------------------
# In production, generate a secure secret with: openssl rand -base64 32
NEXTAUTH_SECRET="portfolio-pro-super-secret-key-change-in-production-2026"
NEXTAUTH_URL="http://localhost:3000"

# SMTP Email Configuration (Nodemailer)
# ------------------------------------------------------------------------------
# Used for auto lead confirmations, sales alerts, and callback notifications.
# Leave blank or mock in development (messages log to console safely).
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="notifications@portfoliopro.in"
SMTP_PASS="your-smtp-password"
EMAIL_FROM="Portfolio Pro <no-reply@portfoliopro.in>"
SALES_EMAIL="sales@portfoliopro.in"

# BSE StarMF & NSE NMF II Order Gateway (Mock / Sandbox)
# ------------------------------------------------------------------------------
# In production, replace with your MFD Member credentials obtained from BSE/NSE.
BSE_STAR_MEMBER_CODE="MFD123456"
BSE_STAR_USER_ID="TESTUSER"
BSE_STAR_PASSWORD="TESTPASSWORD"
BSE_STAR_API_URL="https://bsestarmfdemo.bseindia.com/StarMFWebService/StarMFWebService.svc"

NSE_NMF_BROKER_CODE="NMF8823"
NSE_NMF_APP_KEY="NSE_SANDBOX_KEY_SAMPLE"
NSE_NMF_API_URL="https://sandbox.nsenmf.com/api/v2"

# Payment Gateway (Razorpay Scaffold for Pay Online)
# ------------------------------------------------------------------------------
# Required for online platform subscription fees and advisory software license fees.
RAZORPAY_KEY_ID="rzp_test_placeholderKey123"
RAZORPAY_KEY_SECRET="rzp_test_placeholderSecret456"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholderKey123"

# AMFI Mutual Fund NAV Feed
# ------------------------------------------------------------------------------
# AMFI daily NAV text file endpoint
AMFI_NAV_URL="https://www.amfiindia.com/spages/NAVAll.txt"

# SMS & WhatsApp Gateway (Gupshup / MSG91 / Twilio Placeholder)
# ------------------------------------------------------------------------------
WHATSAPP_API_TOKEN="mock_whatsapp_token_sample"
WHATSAPP_PHONE_NUMBER_ID="mock_phone_id"

